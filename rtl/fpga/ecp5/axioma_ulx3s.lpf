# AxiomaCore-328 - constraints para ULX3S (ECP5 LFE5U-25F, v2.x / v3.0)
#
# FICHERO GENERADO. No editar a mano.
#   Generador: tools/gen_ulx3s_lpf.py
#   Fuente:    rtl/fpga/ecp5/ulx3s_v20_reference.lpf (proyecto ULX3S de emard)
#
# Define el contrato de pines del top rtl/fpga/ecp5/axioma_ulx3s_top.v (fase 2).

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;

## ------------------------------------------------------- señales simples
LOCATE COMP "clk_25mhz" SITE "G2";  # clk_25mhz - oscilador de la placa; el PLL deriva F_CPU
LOCATE COMP "btn_reset" SITE "R1";  # btn[1] - FIRE1. Activo alto en la placa: el top invierte
LOCATE COMP "wifi_gpio0" SITE "L2";  # wifi_gpio0 - debe conducirse a 1 o el ESP32 reinicia la placa
LOCATE COMP "uart_tx" SITE "L4";  # ftdi_rxd - PD1. La FPGA transmite hacia el FTDI
LOCATE COMP "uart_rx" SITE "M1";  # ftdi_txd - PD0. La FPGA recibe del FTDI

IOBUF  PORT "clk_25mhz" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk_25mhz" 25 MHZ;
IOBUF  PORT "btn_reset"  PULLMODE=DOWN IO_TYPE=LVCMOS33;
IOBUF  PORT "wifi_gpio0" PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "uart_tx"    PULLMODE=UP   IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF  PORT "uart_rx"    PULLMODE=UP   IO_TYPE=LVCMOS33;

## led[7:0]  <-  led[0..7]   # espejo de PORTB. PB5 = pin 13 de Arduino = led[5]
LOCATE COMP "led[0]" SITE "B2";  # led[0]
LOCATE COMP "led[1]" SITE "C2";  # led[1]
LOCATE COMP "led[2]" SITE "C1";  # led[2]
LOCATE COMP "led[3]" SITE "D2";  # led[3]
LOCATE COMP "led[4]" SITE "D1";  # led[4]
LOCATE COMP "led[5]" SITE "E2";  # led[5]
LOCATE COMP "led[6]" SITE "E1";  # led[6]
LOCATE COMP "led[7]" SITE "H3";  # led[7]
IOBUF PORT "led[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
IOBUF PORT "led[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

## portb_io[7:0]  <-  gp[0..7]   # PB0-PB7  (Arduino D8-D13 + XTAL)
LOCATE COMP "portb_io[0]" SITE "B11";  # gp[0]
LOCATE COMP "portb_io[1]" SITE "A10";  # gp[1]
LOCATE COMP "portb_io[2]" SITE "A9";  # gp[2]
LOCATE COMP "portb_io[3]" SITE "B9";  # gp[3]
LOCATE COMP "portb_io[4]" SITE "A7";  # gp[4]
LOCATE COMP "portb_io[5]" SITE "C8";  # gp[5]
LOCATE COMP "portb_io[6]" SITE "C6";  # gp[6]
LOCATE COMP "portb_io[7]" SITE "A6";  # gp[7]
IOBUF PORT "portb_io[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portb_io[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portb_io[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portb_io[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portb_io[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portb_io[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portb_io[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portb_io[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;

## portc_io[6:0]  <-  gp[8..14]   # PC0-PC6  (Arduino A0-A5 + RESET)
LOCATE COMP "portc_io[0]" SITE "A4";  # gp[8]
LOCATE COMP "portc_io[1]" SITE "A2";  # gp[9]
LOCATE COMP "portc_io[2]" SITE "C4";  # gp[10]
LOCATE COMP "portc_io[3]" SITE "F4";  # gp[11]
LOCATE COMP "portc_io[4]" SITE "G3";  # gp[12]
LOCATE COMP "portc_io[5]" SITE "H4";  # gp[13]
LOCATE COMP "portc_io[6]" SITE "U18";  # gp[14]
IOBUF PORT "portc_io[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portc_io[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portc_io[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portc_io[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portc_io[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portc_io[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portc_io[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;

## portd_io[7:0]  <-  gn[0..7]   # PD0-PD7  (Arduino D0-D7)
LOCATE COMP "portd_io[0]" SITE "C11";  # gn[0]
LOCATE COMP "portd_io[1]" SITE "A11";  # gn[1]
LOCATE COMP "portd_io[2]" SITE "B10";  # gn[2]
LOCATE COMP "portd_io[3]" SITE "C10";  # gn[3]
LOCATE COMP "portd_io[4]" SITE "A8";  # gn[4]
LOCATE COMP "portd_io[5]" SITE "B8";  # gn[5]
LOCATE COMP "portd_io[6]" SITE "C7";  # gn[6]
LOCATE COMP "portd_io[7]" SITE "B6";  # gn[7]
IOBUF PORT "portd_io[0]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portd_io[1]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portd_io[2]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portd_io[3]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portd_io[4]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portd_io[5]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portd_io[6]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;
IOBUF PORT "portd_io[7]" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=8;

